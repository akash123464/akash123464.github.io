rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Anyone can view products; only a signed-in admin can add, edit, or remove them.
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Anyone can place an order (checkout); only a signed-in admin can view,
    // update its status, or delete it. Customers can't read the order list.
    match /orders/{orderId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }
  }
}
