rules_version = '2';

// ============================================================================
// WISHWORK — Firebase Storage Security Rules
//
// Protects the verification photos people optionally upload at sign-up.
// These are review-only — never shown on the platform — so only the person
// who uploaded one and the admin may ever read it.
//
// Deploy via Firebase Console → Storage → Rules → paste & Publish.
// ============================================================================

service firebase.storage {
  match /b/{bucket}/o {

    match /verification/{userId}/{fileName} {
      allow read: if request.auth != null
                  && (request.auth.uid == userId || request.auth.token.email == 'bhadouryaakash@gmail.com');

      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');

      allow delete: if request.auth != null && request.auth.token.email == 'bhadouryaakash@gmail.com';
    }

    // Everything else is closed by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
